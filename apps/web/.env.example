# Copy to .env.development and .env.production (both gitignored) and adjust.
# On a static host (Netlify, Cloudflare Pages, ...) set these in its build settings instead.

# development = console logging on, production = no logging. Defaults to Vite's mode
# (`yarn dev` = development, `yarn build` = production).
VITE_APP_ENV=development

# Official F1 live timing SignalR Core hub. Leave empty to show the recorded replay only.
VITE_F1_SIGNALR_URL=

# Optional: stream from apps/server instead of connecting to F1 from the browser.
# VITE_SERVER_URL=http://localhost:3001

# Development only: mock track weather for the recorded replay, which has none.
# dry | rain | cycle (rain starts and stops every 30s). Also `?mockWeather=rain` in the URL.
# Never applies to live timing or production builds.
VITE_MOCK_WEATHER=

# Development only: mock session for the replay, which has no session name, lap total or clock.
# race / sprint (lap total) | qualifying / sprint-qualifying (Q1–Q3 or SQ1–SQ3, shortened clocks)
# | practice (1:00:00 clock); clocks count down with the replay. Also `?mockSession=qualifying` in the URL. Never applies to live timing or builds.
VITE_MOCK_SESSION=
