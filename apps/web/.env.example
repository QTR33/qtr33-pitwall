# Copy to .env.development and .env.production (both gitignored) and adjust.
# On a static host (Vercel, Netlify, Cloudflare Pages, ...) set these in its build settings instead.

# development = console logging on; with no session on track the recorded replay plays.
# production  = no logging; with no session on track the page says "No session on track".
# Defaults to Vite's mode (`yarn dev` = development, `yarn build` = production).
VITE_APP_ENV=development

# Official F1 live timing SignalR Core hub. Leave empty to turn live timing off
# (development plays the recorded replay, production shows "Can't reach live timing").
VITE_F1_SIGNALR_URL=

# Optional: stream from apps/server instead of connecting to F1 from the browser.
# VITE_SERVER_URL=http://localhost:3001

# Development only: mock track weather for the recorded replay, e.g. to see rain.
# dry | rain | cycle (rain starts and stops every 30s). Also `?mockWeather=rain` in the URL.
# Never applies to live timing or production builds.
VITE_MOCK_WEATHER=

# Development only: mock session for the replay, e.g. to see a session clock (a race has none).
# race / sprint (lap total) | qualifying / sprint-qualifying (Q1–Q3 or SQ1–SQ3, shortened clocks)
# | practice (1:00:00 clock); clocks count down with the replay. Also `?mockSession=qualifying`
# in the URL. Never applies to live timing or production builds.
VITE_MOCK_SESSION=
