{
  "name": "qtr33-pitwall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,WEB\" -c \"bgBlue.bold,bgMagenta.bold\" \"yarn dev:server\" \"yarn dev:web\"",
    "dev:server": "yarn --cwd apps/server dev",
    "dev:web": "yarn --cwd apps/web dev",
    "build": "yarn --cwd packages/shared build && yarn --cwd apps/server build && yarn --cwd apps/web build",
    "start": "yarn --cwd apps/server start",
    "typecheck": "yarn --cwd packages/shared typecheck && yarn --cwd apps/server typecheck && yarn --cwd apps/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^14.0.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
